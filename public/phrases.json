{"id":"i022","type":"prep","domain":"ielts","phrase":"cope with","answer":"with","prompt":"cope ___ the pressure","choices":["with","to","on","in"],"meaning":"đối phó với","example":"Young engineers must learn to cope [with] pressure.","trap":"cope the pressure","family":"WITH"},
