[
{"id":"w001","type":"prep","domain":"work","phrase":"comply with","answer":"with","prompt":"comply ___ the regulations","choices":["with","to","for","on"],"meaning":"tuân thủ","example":"All subcontractors must comply [with] the airport safety regulations.","trap":"comply the regulations / comply to","family":"WITH"},
